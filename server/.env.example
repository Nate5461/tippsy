# Postgres connection
DATABASE_URL=postgres://tippsy:tippsy@localhost:5432/tippsy?sslmode=disable

# Secret used to sign JWTs. Use a long random string; the server refuses to start if empty.
JWT_SECRET=change-me-to-a-long-random-string

# HTTP port the API listens on.
PORT=8080

# Where uploaded review photos are written on disk.
UPLOAD_DIR=./uploads

# Public base URL used to build absolute photo URLs in responses.
PUBLIC_BASE_URL=http://localhost:8080

# SMTP — Brevo credentials (leave blank to use log sender in local dev)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=ae0476001@smtp-brevo.com
SMTP_PASSWORD=your-brevo-smtp-key-here
SMTP_FROM=Tippsy <charliebissett906@gmail.com>
